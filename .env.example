# Database (SQLite for MVP; a postgresql:// URL also works after switching the provider)
# connection_limit=1 is required for SQLite: Prisma interactive transactions on a
# multi-connection SQLite pool time out under concurrency. Drop it for Postgres.
DATABASE_URL="file:./dev.db?connection_limit=1"

# Session cookie signing is not needed (opaque DB-backed tokens); set to true behind HTTPS
COOKIE_SECURE="false"

# Public base URL, used in emails and field magic links
APP_BASE_URL="http://localhost:3000"

# Timezone is fixed to Asia/Manila in code (Section 1). Do not change.

# SMTP (Step 4). Leave SMTP_HOST empty to log emails to the console instead.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="NNR Export Monitor <noreply@example.com>"

# AI email intake (Step 7). If empty, /intake shows a disabled state.
ANTHROPIC_API_KEY=""

# File uploads (local disk storage backend)
UPLOAD_DIR="./uploads"

# Dev-only clock override (/dev/simulate-time). Never enable in production.
ENABLE_DEV_TOOLS="true"
