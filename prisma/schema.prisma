// NNR Export Monitor schema.
// SQLite for the MVP; kept Postgres-compatible (no SQLite-only types or raw SQL).
// All DateTime values are stored in UTC and displayed in Asia/Manila.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ---------- Enums ----------

enum Role {
  CS
  FIELD
  SUPERVISOR
  CUSTOMER // reserved for the post-MVP customer portal; no UI grants it yet
}

enum CargoType {
  FCL
  LCL
}

enum LclUnit {
  PALLET
  BOX
}

enum ArrastreResponsibility {
  NNR
  SHIPPER
}

// Who files the export declaration ("C/O NNR" / "C/O SHIPPER" in the monitoring sheet).
enum DeclarationBy {
  NNR
  SHIPPER
}

enum DeclarationStatus {
  PENDING
  FILED
  ASSESSED
  RELEASED
}

enum ShipmentStatus {
  BOOKED
  PICKUP_SCHEDULED
  PICKED_UP
  FSI_DONE
  PREADVISED
  DECLARED
  BOC_UPLOADED
  ARRASTRE_PAID
  DOCS_SENT
  DEPARTED
  ARRIVED
  CLOSED
  CANCELLED
}

enum ShipmentSource {
  CS
  EMAIL
  CUSTOMER
  IMPORT
}

enum EventSource {
  WEB
  EMAIL
  FIELD_LINK
  CS_ON_BEHALF
  SYSTEM
  IMPORT
}

enum DeadlineType {
  PICKUP
  FSI
  PREADVISE
  BOC_UPLOAD
  ARRASTRE
}

enum AlertLevel {
  REMINDER
  DUE
  OVERDUE
}

enum AttachmentKind {
  ARRASTRE_PROOF
  EXPORT_DOC
  FIELD_PHOTO
  OTHER
}

enum IntakeStatus {
  PENDING_REVIEW
  CONFIRMED
  REJECTED
}

// ---------- Core ----------

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role
  title        String?  // job title shown in the app, e.g. "CS Export Assistant"; access comes from role
  phone        String?
  viberId      String?
  telegramId   String?
  active       Boolean  @default(true)
  // Only for role CUSTOMER (post-MVP): which shipper this login belongs to.
  shipperId    String?
  shipper      Shipper? @relation(fields: [shipperId], references: [id])
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  sessions          Session[]
  assignedShipments Shipment[]       @relation("AssignedCs")
  createdShipments  Shipment[]       @relation("CreatedBy")
  events            MilestoneEvent[]
  notifications     Notification[]
  alertsAcked       Alert[]          @relation("AlertAckBy")
  fieldLinks        FieldLink[]
  fieldLinksAssigned FieldLink[]     @relation("FieldLinkAssignee")
  intakes           EmailIntake[]
}

model Session {
  id        String   @id // random token, stored hashed (sha256 hex)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model Shipper {
  id                      String                 @id @default(uuid())
  // Permanent customer code, e.g. SHP-0007. Assigned on creation from the "SHIPPER" counter, never reused.
  code                    String                 @unique
  // Unique as typed; createShipper also rejects names that differ only in case, spacing,
  // punctuation or Inc/Corp/Co (see src/lib/shippers.ts).
  name                    String                 @unique
  contactPerson           String?
  email                   String?
  phone                   String?
  defaultPickupAddress    String?
  defaultArrastre         ArrastreResponsibility @default(NNR)
  createdAt               DateTime               @default(now())
  updatedAt               DateTime               @updatedAt

  shipments Shipment[]
  users     User[]
}

model Shipment {
  id        String @id @default(uuid())
  // Ocean export only (see DECISIONS.md). No mode field; numbering formats carry the "O".
  jobNo String  @unique
  hblNo String? @unique // assigned on confirmation, never reused
  // Destination code used in the HBL No. (e.g. TYO in NNRMNLTYOF9904).
  podCode String?
  // "PART OF 8665" in the sheet: the HBL No. this split shipment belongs with.
  partOfHblNo String?

  carrierBookingRef String?

  shipperId     String
  shipper       Shipper @relation(fields: [shipperId], references: [id])
  consigneeName String?
  // Where the field team picks up. Filled from the shipper's default address on the form; editable per shipment.
  pickupAddress String?

  destinationPort String
  pod             String

  // FCL only: JSON array of {size: "20"|"40"|"40HC", qty: number}
  containerPlan Json?
  cargoType     CargoType
  lclQty        Int?
  lclUnit       LclUnit?

  requestedPickupAt DateTime? // null = not yet scheduled (status BOOKED); flagged as missing data
  actualPickupAt    DateTime?

  fsiCutoffAt       DateTime?
  fsiSubmittedAt    DateTime? // set by "Mark FSI submitted"
  preadviseCutoffAt DateTime?
  preadviseSentAt   DateTime? // set by "Mark pre-advise sent"

  arrastreResponsibility     ArrastreResponsibility
  exportDeclarationStatus    DeclarationStatus      @default(PENDING)
  exportDeclarationUpdatedAt DateTime?

  bocUploadAt      DateTime?
  arrastrePaidAt   DateTime?
  arrastreProofId  String?   @unique
  arrastreProof    Attachment? @relation("ArrastreProof", fields: [arrastreProofId], references: [id])
  exportDocsSentAt DateTime?
  exportDocsRecipient String?
  exportDocsSubject   String?
  exportDocsToOverseasAt DateTime? // export docs sent to NNR's overseas office (sheet column V)
  arrastreCutoffAt     DateTime? // terminal's arrastre cut-off, entered by CS
  declarationBy        DeclarationBy @default(NNR)
  declarationForwarder String?        // forwarder NNR files through, e.g. "AAI" from "C/O NNR (AAI)"

  // Computed from deadline_rules by the engine and cached here for querying.
  bocDeadlineAt      DateTime?
  arrastreDeadlineAt DateTime?

  carrierName    String?
  carrierRemarks String?

  // Pick-up instruction sent to the transport (trucking) company. FCL and LCL use different fields;
  // the form clears the ones that do not apply to the cargo type.
  // FCL: empty-container positioning, container yard, port of loading, cut-off (date only).
  positioningAt     DateTime?
  containerYard     String?
  portOfLoading     String?   // MICP/NORTH | SOUTH/ATI | PORT OF BATANGAS | SUBIC (see PORTS_OF_LOADING)
  cyCutoffAt        DateTime? // date only, stored as Manila midnight
  // LCL: consolidator, weight, volume, description, dimensions, warehouse to deliver to.
  consolidator      String?
  grossWeightKg     Float?
  cbm               Float?
  cargoDescription  String?
  cargoDimensions   String?
  deliveryWarehouse String?
  // Both
  pickupRemarks     String?
  pickupInstructionSentAt DateTime? // last time it was emailed to transport

  etdMnl DateTime? // null allowed at DB level so intake can save; flagged as missing data
  atdMnl DateTime?
  eta    DateTime?
  ata    DateTime?

  status       ShipmentStatus @default(BOOKED)
  closedAt     DateTime?
  cancelledAt  DateTime?
  cancelReason String?

  // Flags written by the alert engine (not statuses).
  // Old rows brought in from the spreadsheet as closed history: counted in volumes, not in on-time metrics.
  importedAsHistory Boolean @default(false)
  atRisk  Boolean @default(false)
  overdue Boolean @default(false)

  source      ShipmentSource @default(CS)
  assignedCsId String
  assignedCs   User   @relation("AssignedCs", fields: [assignedCsId], references: [id])
  createdById  String
  createdBy    User   @relation("CreatedBy", fields: [createdById], references: [id])
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  events      MilestoneEvent[]
  alerts      Alert[]
  attachments Attachment[]     @relation("ShipmentAttachments")
  fieldLinks  FieldLink[]
  intake      EmailIntake?

  @@index([status])
  @@index([assignedCsId])
  @@index([shipperId])
  @@index([etdMnl])
}

// Atomic counters for Job No. and HBL No. Key examples: "JOB:2610", "HBL:26".
model NumberSequence {
  key   String @id
  value Int
}

// Append-only audit log. Never updated or deleted.
model MilestoneEvent {
  id         String      @id @default(uuid())
  shipmentId String
  shipment   Shipment    @relation(fields: [shipmentId], references: [id])
  type       String      // e.g. CREATED, PICKED_UP, FSI_SUBMITTED, FIELD_CHANGED, HBL_EDITED
  value      String?     // JSON or plain text describing the change
  note       String?
  actorId    String?
  actor      User?       @relation(fields: [actorId], references: [id])
  source     EventSource
  occurredAt DateTime    @default(now())

  @@index([shipmentId, occurredAt])
  @@index([type, occurredAt])
}

model DeadlineRule {
  id           String       @id @default(uuid())
  deadlineType DeadlineType @unique
  // Due time = shipment[baseField] + offsetMinutes (e.g. PICKUP: requestedPickupAt + 0,
  // BOC_UPLOAD: fsiCutoffAt - 1440). Deliberately not a rule language.
  baseField     String
  offsetMinutes Int          @default(0)
  // Reminder offsets in minutes before due, JSON array e.g. [1440, 240, 60]
  reminderOffsets Json
  overdueRepeatMinutes Int   @default(120)
  overdueMaxPerDay     Int   @default(3)
  enabled       Boolean      @default(true)
  updatedAt     DateTime     @updatedAt
}

model Alert {
  id            String       @id @default(uuid())
  shipmentId    String
  shipment      Shipment     @relation(fields: [shipmentId], references: [id])
  deadlineType  DeadlineType
  level         AlertLevel
  // Minutes relative to due time: negative = before (reminders), 0 = due, positive = overdue repeat.
  offsetMinutes Int
  dueAt         DateTime
  sentAt        DateTime?
  channels      String       @default("") // comma-separated channels delivered, e.g. "IN_APP,EMAIL"
  ackById       String?
  ackBy         User?        @relation("AlertAckBy", fields: [ackById], references: [id])
  ackAt         DateTime?
  snoozedUntil  DateTime?
  resolvedAt    DateTime?    // set when the milestone is completed (or the alert is superseded)
  resolution    String?      // COMPLETED | SUPERSEDED (due time changed) | MOOT (departed/cancelled/closed)
  deliveryError String?      // last channel error, e.g. SMTP failure
  createdAt     DateTime     @default(now())

  notifications Notification[]

  // Idempotency: the same alert is never created (and so never sent) twice.
  @@unique([shipmentId, deadlineType, level, offsetMinutes, dueAt])
  @@index([resolvedAt])
}

// In-app notification center, one row per recipient.
model Notification {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  alertId   String?
  alert     Alert?    @relation(fields: [alertId], references: [id])
  title     String
  body      String
  link      String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, readAt])
}

model EmailIntake {
  id            String       @id @default(uuid())
  rawText       String
  attachmentText String?
  extractedJson Json?
  extractError  String?      // last extraction failure (API down, refusal, …); CS can retry
  model         String?      // model that produced extractedJson
  status        IntakeStatus @default(PENDING_REVIEW)
  shipmentId    String?      @unique
  shipment      Shipment?    @relation(fields: [shipmentId], references: [id])
  createdById   String
  createdBy     User         @relation(fields: [createdById], references: [id])
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
}

model Attachment {
  id           String         @id @default(uuid())
  shipmentId   String
  shipment     Shipment       @relation("ShipmentAttachments", fields: [shipmentId], references: [id])
  kind         AttachmentKind
  storageKey   String         // path inside the storage backend
  originalName String
  mimeType     String
  sizeBytes    Int
  uploadedById String?
  createdAt    DateTime       @default(now())

  arrastreFor Shipment? @relation("ArrastreProof")
}

model FieldLink {
  id          String    @id @default(uuid())
  tokenHash   String    @unique // sha256 of the URL token; raw token is never stored
  shipmentId  String
  shipment    Shipment  @relation(fields: [shipmentId], references: [id])
  createdById String
  createdBy   User      @relation(fields: [createdById], references: [id])
  // Field person the link was made for (optional): their name goes on the timeline.
  assigneeId  String?
  assignee    User?     @relation("FieldLinkAssignee", fields: [assigneeId], references: [id])
  expiresAt   DateTime
  revokedAt   DateTime?
  lastUsedAt  DateTime?
  createdAt   DateTime  @default(now())

  @@index([shipmentId])
}

// Small key/value store for app-wide settings shared by the web app and the scheduler,
// e.g. the dev-only simulated clock offset.
model AppSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}
